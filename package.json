{
  "name": "@wishx127/pi-fast",
  "version": "0.1.2",
  "description": "One /fast toggle for supported models in Pi",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wishx127/pi-fast.git"
  },
